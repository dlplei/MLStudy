# ============================================
# 云端 LLM 配置示例
# ============================================
# 复制此文件为 .env 并根据你的 LLM 提供商修改配置
# cp .env.example.cloud .env

# ============================================
# LLM 提供商配置
# ============================================

# LLM 提供商类型: ollama / openai
# - ollama: 本地 Ollama 服务
# - openai: OpenAI 兼容 API（支持大多数云端 LLM 服务）
LLM_PROVIDER=openai

# LLM API 基础 URL
# 根据你的 LLM 提供商填写：
# - 阿里云通义千问: https://dashscope.aliyuncs.com/compatible-mode
# - 百度文心一言: https://aip.baidubce.com/rpc/2.0/ai_custom/v1
# - 火山引擎（豆包）: https://ark.cn-beijing.volces.com/api
# - DeepSeek API: https://api.deepseek.com
# - OpenAI: https://api.openai.com
# - 其他 OpenAI 兼容服务: 填写对应的 API 地址
LLM_BASE_URL=https://api.deepseek.com

# LLM 模型名称
# 根据你的 LLM 提供商填写：
# - 阿里云: qwen-turbo / qwen-plus / qwen-max
# - 百度: ernie-bot / ernie-bot-turbo
# - 火山引擎: doubao-pro-32k / doubao-lite-32k
# - DeepSeek: deepseek-chat / deepseek-coder
# - OpenAI: gpt-3.5-turbo / gpt-4 / gpt-4-turbo
LLM_MODEL=deepseek-chat

# LLM API Key（云端服务必需）
# 从你的 LLM 提供商控制台获取
LLM_API_KEY=your-api-key-here

# LLM 请求超时时间（秒）
LLM_TIMEOUT=30

# ============================================
# 缓存配置
# ============================================

# 缓存 TTL（秒）
CACHE_TTL=600

# 缓存最大条目数
CACHE_MAX_SIZE=100

# ============================================
# 日志配置
# ============================================

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log

# ============================================
# API 配置
# ============================================

# API 监听地址
API_HOST=0.0.0.0

# API 监听端口
API_PORT=8000

# CORS 允许的来源（前端地址）
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ============================================
# 模拟配置（开发环境）
# ============================================

# 模拟延迟范围（毫秒）
SIMULATE_LATENCY_MIN=50
SIMULATE_LATENCY_MAX=200

# 模拟失败率（0-1）
SIMULATE_FAILURE_RATE=0.05

# LLM 模拟延迟范围（毫秒）
LLM_LATENCY_MIN=800
LLM_LATENCY_MAX=2500
